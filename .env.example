# Copy to .env.local and fill in per environment. Only EXPO_PUBLIC_* vars are
# bundled into the app — never put secrets or service-role keys here.

EXPO_PUBLIC_APP_ENV=development

# Populated once the Supabase project exists (Phase 1).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Visual-review only — see README's "Ocean Glass corrective pass" section.
# Leave unset/false in every real environment, including preview/production.
EXPO_PUBLIC_DEMO_MODE=false
